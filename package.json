{
  "name": "gaming-lounge-manager",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "lint": "tsx scripts/lint.ts",
    "test": "tsx --test test/*.test.ts",
    "test:unit": "tsx --test test/unit_layer.test.ts",
    "test:integration": "tsx --test test/integration_layer.test.ts",
    "test:security": "tsx --test --test-concurrency=1 test/backend_authorization_audit.test.ts test/cors_hardening.test.ts test/csrf_protection.test.ts test/auth_hardening.test.ts test/distributed_rate_limiting.test.ts test/admin_bootstrap_and_secrets.test.ts",
    "test:concurrency": "tsx --test --test-concurrency=1 test/concurrency_lifecycle.test.ts test/concurrent_booking.test.ts test/booking_idempotency.test.ts",
    "test:e2e": "tsx --test test/e2e_full_lifecycle.test.ts",
    "test:strategy": "tsx --test --test-concurrency=1 test/unit_layer.test.ts test/integration_layer.test.ts test/concurrency_lifecycle.test.ts test/e2e_full_lifecycle.test.ts",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "test:ci": "npm run check && npm run lint && npm run test:strategy",
    "test:load": "tsx load-tests/run-load-test.ts",
    "admin:bootstrap": "tsx server/bootstrap-cli.ts",
    "db:migrate": "tsx server/migrate-cli.ts up",
    "db:migrate:rollback": "tsx server/migrate-cli.ts down",
    "db:migrate:status": "tsx server/migrate-cli.ts status",
    "db:migrate:check-safety": "tsx scripts/check-migration-safety.ts",
    "db:backup": "tsx server/dr-cli.ts backup",
    "db:backup:verify": "tsx server/dr-cli.ts verify",
    "db:restore:test": "tsx server/dr-cli.ts restore-test",
    "db:backup:prune": "tsx server/dr-cli.ts prune",
    "db:dr:status": "tsx server/dr-cli.ts status",
    "deploy:staging": "tsx scripts/deploy.ts staging deploy",
    "deploy:production": "tsx scripts/deploy.ts production deploy",
    "rollback:staging": "tsx scripts/deploy.ts staging rollback",
    "rollback:production": "tsx scripts/deploy.ts production rollback"
  },
