# ==============================================================================
# PLAY N' SLAY GAMING LOUNGE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Security Policy:
# 1. NEVER commit real secret values, credentials, or API keys into source control.
# 2. Production startup strictly fails closed if required variables are missing or insecure.
# 3. Automatic default privileged credential seeding is permanently disabled in production.
# 4. Use the secure Initial Administrator Bootstrap process for the first privileged account.
# ==============================================================================

# Application Environment (development | test | staging | production)
NODE_ENV=development

# Server Port (default: 5001)
PORT=5001

# Session Encryption Secret Key (MANDATORY in Production & Staging)
# Minimum 32 high-entropy characters required in production.
# Generate via: openssl rand -base64 32
SESSION_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars

# NextAuth / Auth.js Secret (MANDATORY in Production if NextAuth is active)
AUTH_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars

# PostgreSQL Database Connection (MANDATORY in Production & Staging - Fails Closed)
# Must be a valid PostgreSQL connection URI with non-placeholder credentials.
# In production, SSL mode should be enabled (sslmode=require).
DATABASE_URL=postgresql://db_user:secure_password@db_host:5432/gaming_lounge?sslmode=require

# ==============================================================================
# SECURE INITIAL ADMINISTRATOR BOOTSTRAP
# ==============================================================================
# Required only for fresh production installations prior to initial admin setup.
# Once initial admin is created with MFA, bootstrap is permanently disabled.
# Generate via: openssl rand -hex 32
INITIAL_ADMIN_BOOTSTRAP_TOKEN=replace_with_secure_random_token_for_initial_bootstrap

# ==============================================================================
# EXTERNAL INTEGRATIONS & SECRETS
# ==============================================================================

# Payment Webhook HMAC Secret (Required if payment gateway webhooks are enabled)
# Minimum 16 characters.
PAYMENT_WEBHOOK_SECRET=replace_with_payment_provider_webhook_signing_secret

# Cloudinary Storage Credentials (Optional in Dev, Required if photo uploads enabled)
CLOUDINARY_CLOUD_NAME=your_real_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_real_cloudinary_api_key
CLOUDINARY_API_SECRET=your_real_cloudinary_api_secret

# Google OAuth Single Sign-On (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://gaminglounge.com/api/auth/google/callback

# ==============================================================================
# ENVIRONMENT-SEPARATED CORS ALLOWED ORIGINS
# ==============================================================================
# Development: Defaults to localhost / 127.0.0.1
# DEV_ALLOWED_ORIGINS=http://localhost:5001,http://localhost:5173

# Staging: Explicit HTTPS origins only, zero wildcards allowed
# STAGING_ALLOWED_ORIGINS=https://staging.gaminglounge.com,https://app.staging.gaminglounge.com

# Production: Explicit HTTPS origins only, zero wildcards allowed
# PRODUCTION_ALLOWED_ORIGINS=https://gaminglounge.com,https://app.gaminglounge.com
